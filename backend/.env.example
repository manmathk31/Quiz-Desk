# ==============================================================================
# Quizdesk Backend Environment Template (.env.example)
# Copy this file to .env and supply environment-specific credentials.
# ==============================================================================

# Application Configuration
PROJECT_NAME="Quizdesk API"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
# CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# Database Connection (PostgreSQL via Supabase or local instance)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql+psycopg://postgres:your_password@localhost:5432/quizdesk"

# Supabase Auth & Project Credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT Verification Configuration
# For default Supabase projects using HS256: supply SUPABASE_JWT_SECRET.
# For asymmetric projects (RS256/ES256): supply SUPABASE_JWT_PUBLIC_KEY (PEM format).
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
# SUPABASE_JWT_PUBLIC_KEY=""
SUPABASE_JWT_ALGORITHM="HS256"
SUPABASE_JWT_AUDIENCE="authenticated"

