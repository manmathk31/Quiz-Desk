# ==============================================================================
# Quizdesk Frontend Environment Template (.env.example)
# Copy this file to frontend/.env.local during local development.
# Only variables prefixed with VITE_ are exposed to the browser client bundle.
#
# SECURITY WARNING:
# NEVER place private secrets (e.g., Supabase service role keys, JWT secrets,
# database credentials) in frontend environment files.
# ==============================================================================

# Backend FastAPI Service Base URL
VITE_API_BASE_URL="http://localhost:8000"

# Supabase Public Project Configuration (Safe for browser client)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
